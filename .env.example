# Core runtime
APP_ENV=development
PRODUCTION=false
PORT=3000
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-value

# Dashboard auth: "local" (USER_ID/USER_PASSWORD) or "clerk" (hosted login).
# If unset, "clerk" is used automatically when both Clerk keys below are set.
AUTH_PROVIDER=local
USER_ID=admin
# Production refuses to start with the default or a short password.
USER_PASSWORD=change-me-to-a-long-passphrase
SHOW_LOGIN_CREDENTIAL_HINTS=false

# Clerk (https://dashboard.clerk.com -> API keys). Keep the secret key private.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: defaults to https://<frontend-api-from-publishable-key>/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional comma-separated origins allowed in the token's azp claim, e.g. https://app.example.com
CLERK_AUTHORIZED_PARTIES=
# Who may sign in. Anyone can sign up on a Clerk instance, so set one of these.
CLERK_ALLOWED_EMAILS=
CLERK_ALLOWED_DOMAINS=
# Only for demos: let every authenticated Clerk user in.
CLERK_ALLOW_ANY_USER=false

# PDFs with more pages than this are rejected (each page is OCR'd). 1-100.
MAX_PDF_PAGES=20

# Browser security. Secure cookies need HTTPS (default: on in production, off locally).
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8
# If a page breaks, set SECURITY_CSP_REPORT_ONLY=true to log CSP problems instead of blocking.
SECURITY_CSP_REPORT_ONLY=false

# Trust X-Forwarded-For only when a reverse proxy you control sets it (the bundled nginx does).
TRUST_PROXY_HEADERS=false

# true = also mask 12-digit numbers that fail the Aadhaar checksum (better recall, more false positives)
AADHAAR_ALLOW_UNCHECKED=true

# Hashing and integrity
HASH_ALGORITHM=sha256
HASH_SECRET=change-me-to-a-long-random-value

# API protection
API_KEY_REQUIRED=false
API_KEY=panel-demo-key
APP_API_KEY=panel-demo-key
HEALTH_DETAILS_TOKEN=
IDENTITY_DB_PATH=output/identity_profiles.sqlite3
AUDIT_LOG_PATH=output/audit.log
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RETURN_RAW_AADHAAR=false

# Last4 + one-time code access flow
ACCESS_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=300
ACCESS_MAX_ATTEMPTS=5
# Keep false by default. Set true only for controlled demo environments.
ACCESS_SHOW_CODE=false
# Document storage: "local" (output/ folder) or "s3" (any S3-compatible bucket: AWS S3, Cloudflare R2,
# Supabase Storage, MinIO). Use a PRIVATE bucket. Files are served only through this app's access checks.
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=docmask
S3_REGION=
# Leave empty for AWS S3. R2 example: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side encryption header (AWS: AES256 or aws:kms). Leave empty for services that reject it (some R2/MinIO setups).
S3_SSE=AES256
# true for MinIO and some other self-hosted services
S3_FORCE_PATH_STYLE=false
PERSIST_ORIGINAL_UPLOADS=false
ORIGINAL_UPLOADS_DIR=output/uploads
STORAGE_CLEANUP_ENABLED=false
STORAGE_RETENTION_DAYS=30
STORAGE_CLEANUP_AT_STARTUP=true
# Optional fallback for fully masked Aadhaar (no visible fragment).
# Example: admin-known secret used with jobId + OTP.
ACCESS_FALLBACK_SECRET=

# OCR
# Example (Windows): C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Keep false for fast startup checks. Set true only if you want strict qreader import validation.
STRICT_QREADER_IMPORT=false

# Branding
BRAND_PROJECT_TITLE=Smart Document Masking
BRAND_COLLEGE_NAME=ABC Institute of Technology
BRAND_DEPARTMENT=Department of Computer Science
BRAND_GUIDE_NAME=Dr. Your Guide Name
BRAND_STUDENT_NAME=Your Name
BRAND_REG_NO=N/A
BRAND_YEAR=Final Year
BRAND_LOGO_URL=
IDENTITY_REQUIRE_OTP=true
IDENTITY_OTP_TTL_SECONDS=180
IDENTITY_OTP_MAX_ATTEMPTS=5
IDENTITY_OTP_COOLDOWN_SECONDS=30
IDENTITY_SHOW_OTP=false

# Use email/sms provider for production. "demo" should only be used locally.
IDENTITY_OTP_PROVIDER=email
IDENTITY_DOC_MAX_BYTES=5242880
